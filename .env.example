# =====================================================================
# RAG Production Application - Environment Configuration
# =====================================================================

# --- OpenAI API Key (Required for Embeddings and LLM Generation) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- LLM and Embedding Model Settings ---
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# --- Qdrant Vector DB Settings ---
# Mode options:
# 1) "local"  - Embedded disk storage in ./qdrant_storage (No Docker needed!)
# 2) "remote" - Connect to external Qdrant server or Qdrant Cloud
QDRANT_MODE=local
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=rag_documents
# If using remote or Qdrant Cloud:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Chunking Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5

# --- Inngest Workflow Settings ---
INNGEST_APP_NAME=rag_agent_app
INNGEST_DEV_SERVER_URL=http://127.0.0.1:8288
INNGEST_API_BASE=http://127.0.0.1:8288/v1
