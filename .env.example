# =====================================================================
# RAG Production Application - Environment Configuration
# =====================================================================

# --- Embedding Settings ---
# EMBEDDING_PROVIDER can be 'fastembed' (100% Free, runs locally, no API key needed) or 'openai'
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Optional OpenAI Settings (Only needed if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Multi-Model LLM Configuration (Groq Free Tier) ---
# LLM_PROVIDER can be 'groq' (recommended for ultra-fast free tier CRAG) or 'openai'
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
# High-reasoning model for synthesizing context-grounded final response
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
# Ultra-fast model for document grading, query rewriting, and hallucination check
GROQ_EVALUATION_MODEL=qwen/qwen3.8-27b


# --- Qdrant Vector DB Settings ---
# Mode options:
# 1) "local"  - Embedded disk storage in ./qdrant_storage (No Docker needed!)
# 2) "remote" - Connect to external Qdrant server or Qdrant Cloud
QDRANT_MODE=local
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=rag_documents
# If using remote or Qdrant Cloud:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Chunking Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5

# --- Inngest Workflow Settings ---
INNGEST_APP_NAME=rag_agent_app
INNGEST_DEV_SERVER_URL=http://127.0.0.1:8288
INNGEST_API_BASE=http://127.0.0.1:8288/v1
